{
  "name": "team4-backend",
  "version": "1.0.0",
  "description": "Team4 Backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kainos-birmingham-academy-2026/team4-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kainos-birmingham-academy-2026/team4-backend/issues"
  },
  "homepage": "https://github.com/kainos-birmingham-academy-2026/team4-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "vitest": {
    "environment": "node"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
